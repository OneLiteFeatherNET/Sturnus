{
  // Nuxt writes the real configuration into `.nuxt`, which is generated and
  // not committed. Without this file `nuxt typecheck` has nothing to extend
  // and fails before it checks anything -- so the script existed and proved
  // nothing. This points at the generated one; the settings themselves stay
  // Nuxt's, so they cannot drift out of step with the framework version.
  "extends": "./.nuxt/tsconfig.json"
}
