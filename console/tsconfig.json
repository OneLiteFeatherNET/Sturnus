{
  // Nuxt generates the real configuration into `.nuxt`, which is not
  // committed -- so `npm run typecheck` had nothing to find and failed
  // before it checked anything. This is the one file that points at the
  // generated one; the settings themselves stay Nuxt's, so they cannot
  // drift out of step with the framework version.
  "extends": "./.nuxt/tsconfig.json"
}
